# Local development only. make bootstrap generates private random credentials in .env.
APP_ENV=local
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://mea_demo:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/mea_demo # pragma: allowlist secret
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# AI and outbound integration are implemented in later modules.
AI_ENABLED=false
OUTBOUND_ENABLED=false
# Reserved for later modules; these integrations are not implemented by M00.
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_MIGRATION_URL=
# LINE OA @894attlg (C.2.3). Paste secrets yourself; never commit or share them.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Comma-separated LINE user IDs allowed to receive replies outside production.
LINE_ALLOWED_RECIPIENTS=
# LINE message quota control (C.2.3); empty = use package quota and defaults.
LINE_PUSH_MONTHLY_BUDGET=
LINE_PUSH_CRITICAL_RESERVE_PERCENT=
LINE_REPLY_DEADLINE_SECONDS=
THAILLM_BASE_URL=
THAILLM_MODEL=
THAILLM_REVISION=
THAILLM_API_KEY=
LEGACY_MODE=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PRIVATE_MEDIA_ROOT=
# clamd for attachment scans (make clamav); web container uses clamav:3310.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
