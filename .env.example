# Local development only. make bootstrap generates private random credentials in .env.
APP_ENV=local
# false: no debug pages, for a local stack reachable from the internet (e.g. through ngrok).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://mea_demo:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/mea_demo # pragma: allowlist secret
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# AI and outbound integration are implemented in later modules.
AI_ENABLED=false
# Agent uses the current AI profile and actor-bound MCP tools; guided menus remain available.
AI_MCP_ENABLED=true
OUTBOUND_ENABLED=false
# Reserved for later modules; these integrations are not implemented by M00.
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_MIGRATION_URL=
# LINE OA @705ttrga (C.2.3; replaced @894attlg on 28 Oct 2026). Paste secrets yourself; never commit or share them.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Comma-separated LINE user IDs allowed to receive replies outside production.
LINE_ALLOWED_RECIPIENTS=
# LINE message quota control (C.2.3); empty = use package quota and defaults.
LINE_PUSH_MONTHLY_BUDGET=
LINE_PUSH_CRITICAL_RESERVE_PERCENT=
LINE_REPLY_DEADLINE_SECONDS=
# ThaiLLM (M05): bootstrap values for `manage.py import_ai_config`; runtime uses the active DB profile.
THAILLM_BASE_URL=https://thaillm.or.th/api/v1
THAILLM_MODEL=typhoon-s-thaillm-8b-instruct
THAILLM_FALLBACK_MODELS=OpenThaiGPT-ThaiLLM-8B-Instruct-v7.2,THaLLE-0.2-ThaiLLM-8B-fa,Pathumma-ThaiLLM-qwen3-8b-think-3.0.0
THAILLM_API_KEY=
# Generated by make bootstrap; encrypts stored AI API keys.
AI_SECRET_KEY=
# AI providers, their keys and allowed hosts are set on the admin page (ADR 0038).
# Harness versions: start the next model in parallel after this many seconds.
AI_HEDGE_AFTER_SECONDS=6
LEGACY_MODE=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PRIVATE_MEDIA_ROOT=
# clamd for attachment scans (make clamav); web container uses clamav:3310.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
# Orchestration (M04): generated by make bootstrap; never commit real values.
ORCHESTRATOR_TOKEN=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# Push is off outside production unless set to true (cap 10/month outside production).
LINE_PUSH_ENABLED=
LINE_PUSH_DEBOUNCE_MINUTES=
# Inventory seam (M07): empty = fake outside production, manual_reference in production.
INVENTORY_MODE=
INVENTORY_STALE_HOURS=

# M10 staff web: staff email notifications (off until addresses and SMTP are agreed)
STAFF_EMAIL_ENABLED=
STAFF_WEB_BASE_URL=
# ADR 0040 Broadcast Mini App: channel ID that issues the ID token and its LIFF ID (provider of
# the OA). Media URLs fall back to STAFF_WEB_BASE_URL; both must be public HTTPS for LINE.
LINE_MINI_CHANNEL_ID=
LINE_LIFF_ID=
BROADCAST_MEDIA_BASE_URL=
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
# Private กอจ. Google Sheets: read-only service-account JSON outside the repository.
KOJ_GOOGLE_CREDENTIALS_FILE=

# ADR 0037: เอกสารความรู้ on Pinecone (Starter plan, no card); used only when ตัวเลือกระบบ
# free_chat_docs is on. The index uses integrated embedding with the text field chunk_text.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=knowledge
