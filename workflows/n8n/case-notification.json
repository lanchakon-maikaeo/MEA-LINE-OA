{
  "id": "faojCaseNotify01",
  "name": "FAOJ case-notification v1",
  "active": true,
  "nodes": [
    {
      "id": "a7dc3a25-b6c5-563f-9c26-358d7d9c2054",
      "name": "หมายเหตุ",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "content": "## case-notification v1\nClaim `notification.requested` from Django and ask Django to send each one.\nDjango re-checks the recipient, applies the message budget (C.2.3) and settles the event.\nThis workflow never chooses recipients and holds no LINE token.",
        "width": 420,
        "height": 220
      }
    },
    {
      "id": "b9d9570b-cc1f-5036-9fe8-681b390c4c25",
      "name": "ทุก 10 วินาที",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "e5351c75-5092-50cc-9cb2-e5e0bfe9014a",
      "name": "Claim notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://web:8000/internal/v1/outbox/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"event_types\": [\"notification.requested\"], \"limit\": 10, \"lease_seconds\": 60}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "faojDjangoToken1",
          "name": "Django internal token"
        }
      }
    },
    {
      "id": "f0a5ee61-316f-5b7a-828d-7507b8ceb839",
      "name": "แยกทีละงาน",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "events",
        "options": {}
      }
    },
    {
      "id": "5c2fcf94-dc0b-58ed-b44f-65737f252527",
      "name": "Send via Django",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://web:8000/internal/v1/notifications/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $json.event_id, lease_token: $json.lease_token }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "faojDjangoToken1",
          "name": "Django internal token"
        }
      }
    }
  ],
