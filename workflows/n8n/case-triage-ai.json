      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ],
      "parameters": {
        "content": "## case-triage-ai v1 (M06)\nEvery 10 s: claim `case.triage_ai_requested` and ask Django to run the AI triage. Django screens the case text, asks the active triage version for facts with quotes (equipment, reported hazard, severe impact, registry-only), drops any fact the requester's words do not support and recomputes the rule-based proposal. The AI never picks a division or a level (ADR 0002); if it fails, the rules and the keyword flag still apply. This workflow holds no AI key and chooses no model, URL or recipient.",
        "width": 460,
        "height": 240
      }
    },
    {
      "id": "5bffbf8c-fed3-5319-8be7-9a8add3f799f",
      "name": "ทุก 10 วินาที",
