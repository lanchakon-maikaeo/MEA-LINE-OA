<?xml version="1.0" encoding="UTF-8"?>
<!-- deploy/standby.sh check every 5 minutes while this Mac is on (ADR 0015 Q9). Install with
     make standby-schedule; remove with launchctl bootout gui/$(id -u)/th.or.mea.faoj.standby -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>th.or.mea.faoj.standby</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@BIN@/standby.sh</string>
    <string>check</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/faoj-standby.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/faoj-standby.log</string>
</dict>
</plist>
