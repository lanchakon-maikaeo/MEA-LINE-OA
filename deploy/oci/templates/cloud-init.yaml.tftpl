#cloud-config
# ${name} (${env}): Docker, automatic security updates, /srv/faoj (data volume or boot volume) and
# the faoj-install helper. Everything else arrives inside a release image (M12).
package_update: true
package_upgrade: true
packages:
  - docker.io
  - docker-compose-v2
  - python3
  - openssl
  - unattended-upgrades
  - ca-certificates
write_files:
  - path: /etc/faoj/host.env
    permissions: "0644"
    content: |
      FAOJ_ENV=${env}
      FAOJ_HOST=${name}
      FAOJ_DATA_VOLUME=${data_volume ? "yes" : "no"}
  - path: /usr/local/sbin/faoj-mount-data
    permissions: "0755"
    content: |
      #!/bin/sh
      # Wait for the paravirtualized data volume, format it once, mount it at /srv/faoj. A host
      # without one (FAOJ_DATA_VOLUME=no) keeps /srv/faoj on the boot volume.
      set -eu
      . /etc/faoj/host.env
      [ "$FAOJ_DATA_VOLUME" = yes ] || { mkdir -p /srv/faoj; exit 0; }
      dev=/dev/oracleoci/oraclevdb
      i=0; until [ -e "$dev" ]; do i=$((i + 1)); [ "$i" -gt 120 ] && exit 1; sleep 5; done
      blkid "$dev" >/dev/null 2>&1 || mkfs.ext4 -q -L faojdata "$dev"
      mkdir -p /srv/faoj
      grep -q 'LABEL=faojdata' /etc/fstab || echo 'LABEL=faojdata /srv/faoj ext4 defaults,nofail 0 2' >> /etc/fstab
      mountpoint -q /srv/faoj || mount /srv/faoj
  - path: /usr/local/sbin/faoj-ocir-login
    permissions: "0755"
    content: |
      #!/bin/sh
      # Log Docker in to OCIR with this host's instance principal (faoj-hosts may read repos), so
      # no auth token is stored here. The token lasts about an hour; faoj logs in again before pulls.
      set -eu
      region=$${OCI_REGION:-ap-singapore-1}
      cli=$${OCI_CLI_IMAGE:-ghcr.io/oracle/oci-cli@sha256:48884d8710d30356cac71c7aa678873a97c53c594fefdf2724c80270f3ca563b}
      docker run --rm "$cli" raw-request --http-method GET --auth instance_principal \
        --target-uri "https://$region.ocir.io/20180419/docker/token" \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"]["token"])' \
        | docker login -u BEARER_TOKEN --password-stdin "$region.ocir.io" >/dev/null
  - path: /usr/local/sbin/faoj-install
    permissions: "0755"
    content: |
      #!/bin/bash
      # First release on this host: sudo faoj-install <region>.ocir.io/<ns>/faoj/app@sha256:…
      set -euo pipefail
      image=$${1:?image digest}
      . /etc/faoj/host.env
      [ "$FAOJ_DATA_VOLUME" = no ] || mountpoint -q /srv/faoj || { echo "data volume is not mounted at /srv/faoj" >&2; exit 1; }
      /usr/local/sbin/faoj-ocir-login
      ip=$(curl -s -H 'Authorization: Bearer Oracle' http://169.254.169.254/opc/v2/vnics/ | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["publicIp"])' 2>/dev/null || true)
      host=$${PUBLIC_HOST:-$${ip//./-}.sslip.io}
      tmp=$(mktemp -d); cid=$(docker create "$image")
      docker cp "$cid:/app/deploy/server/." "$tmp/" >/dev/null; docker rm "$cid" >/dev/null
      FAOJ_ROOT=/srv/faoj "$tmp/bootstrap-host.sh" --env "$FAOJ_ENV" --public-host "$host"
      echo "Edit /srv/faoj/env/*.secret.env (LINE, backup keys), then:"
      echo "  sudo FAOJ_ROOT=/srv/faoj $tmp/bin/faoj deploy $image$([ "$FAOJ_ENV" = production ] && echo ' --approval \"…\"')"
runcmd:
  - [ /usr/local/sbin/faoj-mount-data ]
  - [ systemctl, enable, --now, docker ]
  - [ systemctl, enable, --now, unattended-upgrades ]
  # Oracle's Ubuntu images reject inbound traffic other than SSH in iptables; open 80/443 too.
  - [ sh, -c, "iptables -C INPUT -p tcp -m multiport --dports 80,443 -j ACCEPT 2>/dev/null || iptables -I INPUT 5 -p tcp -m multiport --dports 80,443 -j ACCEPT" ]
  - [ sh, -c, "command -v netfilter-persistent >/dev/null && netfilter-persistent save || true" ]
